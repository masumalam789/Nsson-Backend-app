<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title><%= title %></title>
</head>

<body
  style="
    margin:0;
    padding:0;
    background:#f4f6f8;
    font-family:Arial, Helvetica, sans-serif;
  "
>

  <table
    width="100%"
    cellpadding="0"
    cellspacing="0"
    style="background:#f4f6f8;"
  >
    <tr>
      <td align="center">

        <table
          width="650"
          cellpadding="0"
          cellspacing="0"
          style="
            background:#ffffff;
            margin:40px 0;
            border-radius:12px;
            overflow:hidden;
            box-shadow:0 4px 15px rgba(0,0,0,0.08);
          "
        >

          <!-- Header -->
          <tr>
            <td
              style="
                background:linear-gradient(135deg,#0f766e,#10b981);
                text-align:center;
                padding:40px;
              "
            >

              <% if (logoUrl) { %>
                <img
                  src="<%= logoUrl %>"
                  alt="NSSON Auto Parts"
                  width="180"
                  style="
                    display:block;
                    margin:0 auto 25px auto;
                  "
                />
              <% } %>

              <h1
                style="
                  margin:0;
                  color:white;
                  font-size:28px;
                  letter-spacing:1px;
                "
              >
                NSSON AUTO PARTS
              </h1>

              <p
                style="
                  color:#d1fae5;
                  margin-top:10px;
                  font-size:14px;
                "
              >
                India's Most Trusted Brand
              </p>

            </td>
          </tr>

          <!-- Content -->
          <tr>
            <td
              style="
                padding:40px;
                color:#374151;
                line-height:1.8;
                font-size:15px;
              "
            >

              <%- content %>

            </td>
          </tr>

          <!-- Footer -->
          <tr>
            <td
              style="
                background:#f9fafb;
                border-top:1px solid #e5e7eb;
                text-align:center;
                padding:30px;
              "
            >

              <p
                style="
                  margin:0;
                  font-size:15px;
                  font-weight:600;
                  color:#111827;
                "
              >
                NSSON Auto Parts
              </p>

              <p
                style="
                  margin:10px 0;
                  color:#6b7280;
                  font-size:13px;
                "
              >
                📞 +91 97780 39977
              </p>

              <p
                style="
                  margin:10px 0;
                  color:#6b7280;
                  font-size:13px;
                "
              >
                ✉️ nssonautoparts@gmail.com
              </p>

              <p
                style="
                  margin-top:20px;
                  color:#9ca3af;
                  font-size:12px;
                "
              >
                © <%= currentYear %> NSSON Auto Parts.
                All Rights Reserved.
              </p>

            </td>
          </tr>

        </table>

      </td>
    </tr>
  </table>

</body>
</html>
