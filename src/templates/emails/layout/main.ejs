<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title><%= typeof title !== 'undefined' ? title : 'NSSON Auto Parts' %></title>
</head>
<body style="margin:0; padding:0; background:#f1f5f9; font-family:Arial, Helvetica, sans-serif;">
  <table width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9; padding: 40px 0;">
    <tr>
      <td align="center">
        <table width="580" cellpadding="0" cellspacing="0"
          style="background:#ffffff; border-radius:10px; overflow:hidden; box-shadow:0 2px 12px rgba(0,0,0,0.07);">

          <!-- HEADER -->
<!-- HEADER -->
<tr>
  <td style="padding:20px 32px; border-bottom:2px solid #0f766e; background:#ffffff; text-align:center;">
    <table cellpadding="0" cellspacing="0" style="margin:0 auto;">
      <tr>
        <td style="vertical-align:middle; width:44px;">
          <img src="<%= typeof logoUrl !== 'undefined' ? logoUrl : '' %>" alt="NSSON" width="44" height="44"
            style="display:block; border-radius:6px; object-fit:cover;" />
        </td>
        <td style="vertical-align:middle; padding-left:10px;">
          <p style="margin:0; font-size:16px; font-weight:700; color:#0f766e; letter-spacing:0.4px;">NSSON AutoParts</p>
          <p style="margin:2px 0 0 0; font-size:10px; color:#94a3b8; letter-spacing:0.3px; text-transform:uppercase;">India's Most Trusted Brand</p>
        </td>
      </tr>
    </table>
  </td>
</tr>
          <!-- BODY -->
          <tr>
            <td style="padding:36px 32px; color:#374151; font-size:15px; line-height:1.8;">
              <%- content %>
            </td>
          </tr>

          <!-- FOOTER -->
<tr>
  <td style="background:#f8fafc; border-top:1px solid #e2e8f0; padding:20px 32px; text-align:center;">
    <p style="margin:4px 0 0 0; font-size:12px; color:#64748b;">📞 <%= supportPhone %> &nbsp;|&nbsp; ✉️ <%= supportEmail %></p>
    <p style="margin:6px 0 0 0; font-size:11px; color:#94a3b8;">© <%= currentYear %> All Rights Reserved.</p>
  </td>
</tr>

        </table>
      </td>
    </tr>
  </table>
</body>
</html>
