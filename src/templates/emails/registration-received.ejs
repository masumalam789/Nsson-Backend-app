<!DOCTYPE html>
<html>
  <body style="margin: 0; background: #f4f6f8; font-family: Arial, sans-serif">
    <div
      style="
        max-width: 650px;
        margin: 40px auto;
        background: #fff;
        padding: 40px;
        border-radius: 12px;
      "
    >
      <img
        src="<%= logoUrl %>"
        width="160"
        style="display: block; margin: auto auto 25px auto"
      />

      <h2>Registration Received</h2>

      <p>Dear <strong><%= firstName %></strong>,</p>

      <p>Thank you for registering with NSSON Auto Parts.</p>

      <p>Your retailer registration request has been successfully received.</p>

      <p>
        Our verification team is currently reviewing your details. You will
        receive another email once the review process is completed.
      </p>

      <div
        style="
          background: #eff6ff;
          padding: 20px;
          border-left: 4px solid #2563eb;
          border-radius: 6px;
          margin-top: 25px;
        "
      >
        Status: Under Review
      </div>
    </div>
  </body>
</html>
