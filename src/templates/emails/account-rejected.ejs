<!DOCTYPE html>
<html>
  <body style="margin: 0; background: #f4f6f8; font-family: Arial, sans-serif">
    <div
      style="
        max-width: 650px;
        margin: 40px auto;
        background: #fff;
        padding: 40px;
        border-radius: 12px;
      "
    >
      <img
        src="<%= logoUrl %>"
        width="160"
        style="display: block; margin: auto auto 25px auto"
      />

      <h2 style="color: #dc2626">Registration Update</h2>

      <p>Dear <strong><%= firstName %></strong>,</p>

      <p>Thank you for your interest in partnering with NSSON Auto Parts.</p>

      <p>
        After reviewing the submitted details, we are unable to approve your
        registration at this time.
      </p>

      <p>For further clarification, please contact our support team.</p>

      <hr />

      <p>
        📞 <%= supportPhone %><br />
        ✉️ <%= supportEmail %>
      </p>

      <p style="font-size: 12px; color: #9ca3af">
        © <%= currentYear %> NSSON Auto Parts. All Rights Reserved.
      </p>
    </div>
  </body>
</html>
