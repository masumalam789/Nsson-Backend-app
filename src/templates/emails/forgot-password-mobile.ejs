<!-- Icon -->
<div style="text-align:center; margin-bottom:24px;">
  <div style="display:inline-block; background:#f0fdf4; border-radius:50%;
              width:64px; height:64px; line-height:64px; font-size:30px;">
    🔐
  </div>
</div>

<h2 style="margin:0 0 8px 0; font-size:22px; font-weight:700; color:#111827; text-align:center;">
  Password Reset Request
</h2>
<p style="margin:0 0 24px 0; font-size:13px; color:#6b7280; text-align:center;">
  For your <strong><%= companyName %></strong> mobile app account
</p>

<p style="margin:0 0 6px 0;">Hi <strong><%= firstName %></strong>,</p>
<p style="margin:0 0 28px 0; color:#6b7280; font-size:14px; line-height:1.6;">
  We received a request to reset your password. Tap the button below — it will open
  the <strong><%= companyName %></strong> app where you can set a new password.
</p>

<!-- CTA Button -->
<div style="text-align:center; margin:0 0 28px 0;">
  <a href="<%= verifyUrl %>"
    style="background:#0f766e; color:#ffffff; text-decoration:none;
            padding:13px 36px; border-radius:8px; display:inline-block;
            font-size:15px; font-weight:700; letter-spacing:0.3px;">
    Reset My Password
  </a>
</div>

<!-- How it works -->
<div style="background:#f8fafc; border:1px solid #e2e8f0; border-radius:8px;
            padding:14px 18px; margin-bottom:16px; font-size:13px; color:#475569; line-height:1.6;">
  📱 <strong>How it works:</strong> Tapping the button will open your browser briefly
  to verify the link, then automatically redirect you into the
  <strong><%= companyName %></strong> app to set your new password.
</div>

<!-- Expiry notice -->
<div style="background:#f0fdf4; border-left:4px solid #10b981;
            padding:14px 18px; border-radius:6px; margin-bottom:12px;
            font-size:13px; color:#065f46; line-height:1.5;">
  ⏱ This link expires in <strong>1 hour</strong>. After that you'll need to request a new one.
</div>

<!-- Security notice -->
<div style="background:#fff7ed; border-left:4px solid #f97316;
            padding:14px 18px; border-radius:6px; margin-bottom:28px;
            font-size:13px; color:#92400e; line-height:1.5;">
  🔒 Didn't request this? You can safely ignore this email.
  Your account remains secure and no changes have been made.
</div>

<!-- Fallback link -->
<p style="margin:0 0 4px 0; font-size:12px; color:#94a3b8;">
  Button not working? Copy and paste this link into your browser:
</p>
<p style="margin:0 0 28px 0; font-size:12px; word-break:break-all; color:#64748b;">
  <%= verifyUrl %>
</p>

<p style="margin:0;">Regards,<br /><strong>Team <%= companyName %></strong></p>
